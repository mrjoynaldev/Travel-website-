{
  "name": "@fieldnote/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/_core/index.ts",
    "build": "NODE_ENV=production esbuild src/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fieldnote/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "@trpc/server": "^11.6.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jose": "6.1.0",
    "nanoid": "^5.1.5",
    "sanitize-html": "^2.17.6",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.4"
  }
}
